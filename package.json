{
  "name": "holdfast-emergency-planning-system",
  "productName": "Holdfast Emergency Planning System",
  "version": "0.3.0",
  "description": "Holdfast: offline-first household emergency planner for Windows (UK/Wales).",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/clean-dist.js && node scripts/build-launcher.js && electron-builder --win portable nsis && node -e \"require('fs').rmSync('dist/builder-debug.yml', { force: true })\"",
    "launcher": "node scripts/build-launcher.js",
    "icons": "electron scripts/build-icons.js",
    "smoke": "electron scripts/smoke.js",
    "installer-art": "electron scripts/build-installer-art.js"
  },
  "build": {
    "appId": "uk.local.emergencyplanner",
    "publish": null,
    "productName": "Holdfast Emergency Planning System",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/build/*.map",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/launcher.exe", "to": "launcher.exe" }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Holdfast Emergency Planning System",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "chart.js": "^4.4.4",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
