{
  "name": "holdfast-emergency-planning-system",
  "productName": "Holdfast Emergency Planning System",
  "version": "0.2.0",
  "description": "Holdfast: offline-first household emergency planner for Windows (UK/Wales).",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "icons": "electron scripts/build-icons.js",
    "smoke": "electron scripts/smoke.js",
    "installer-art": "electron scripts/build-installer-art.js"
  },
  "build": {
    "appId": "uk.local.emergencyplanner",
    "productName": "Holdfast Emergency Planning System",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Holdfast Emergency Planning System",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "chart.js": "^4.4.4",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
